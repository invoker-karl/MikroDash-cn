  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "TypeScript bundled by cmd/webbuild via esbuild\u2019s Go API",
        "Pages join WebSocket rooms named page-<key>"
      ]
    },
    {
      "dot": "emerald",
      "title": "Router side",
      "items": [
        "Async mode is mandatory: the tag map absorbs a cancelled reply",
        "Bottleneck is concurrent API channels on the MikroTik, not CPU"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "Guards and alert rules are pure: rows in, verdict out",
        "A resource declaring an unported guard has its writes REFUSED",
        "Secret fields travel to the router and never back"
      ]
    }
  ]
